# .env.example — ChestX-Ray AI Dashboard
# Copy this file to .env and fill in your actual API keys.
# NEVER commit the real .env file to Git.

# ── Required ──────────────────────────────────────────────────────────────────

# Google Gemini API Key (get it from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIza-your-gemini-key-here

# Roboflow API Key (get it from https://app.roboflow.com → Settings → API)
ROBOFLOW_API_KEY=your-roboflow-key-here

# ── Optional ──────────────────────────────────────────────────────────────────

# Anthropic Claude API Key (backup AI reporter — optional)
CLAUDE_API_KEY=sk-ant-your-claude-key-here

# Local model weights path (leave default unless you changed the training output)
MODEL_PATH=models/weights/best_model.pth

# Dashboard settings
DEBUG_MODE=False
ENABLE_CLAUDE=False
